# Copy to .env for standalone (non-docker) runs; deploy/docker-compose.yml sets these itself.
STREAMER_BROKER_HOSTS=["localhost:9092"]
STREAMER_SENSORS_TOPIC=tilthwave.sensors.dev
STREAMER_WATER_CONTROL_TOPIC=tilthwave.water-control.dev
STREAMER_LOG_LEVEL=INFO
API_BASE_URL=http://localhost:8080
API_USERNAME=simulator
API_PASSWORD=
SENSORS_ROUNDS=0
SENSORS_INTERVAL_SECONDS=15
