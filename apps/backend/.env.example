# Copy to .env and fill in real values. Never commit .env.

# Database
POSTGRES_HOST=db
POSTGRES_DB=tilthwave
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
POSTGRES_DUMP_PATH=app/infrastructure/data/dump.sql

# FastAPI (generate a 32+ byte secret: python -c "import secrets;print(secrets.token_urlsafe(48))")
API_SECRET_KEY=change-me-to-a-long-random-secret
API_ALGORITHM=HS256
API_ACCESS_TOKEN_EXPIRE=120

# Streamer / broker
STREAMER_BROKER_HOSTS=["tilthwave-sandbox-redpanda:29092"]
STREAMER_SENSORS_TOPIC=tilthwave.sensors.dev
STREAMER_WATER_CONTROL_TOPIC=tilthwave.water-control.dev
STREAMER_LOG_LEVEL=INFO
STREAMER_LOG_FILENAME=logs/streamer.log

# Flow runner
FLOW_RUNNER_MINUTES=0.2
