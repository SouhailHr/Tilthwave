# Only needed to run a backend process on the host against the docker stack; containers get these from
# deploy/docker-compose.yml. Never commit .env.
POSTGRES_HOST=localhost
POSTGRES_DB=tilthwave
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

API_SECRET_KEY=            # python -c "import secrets;print(secrets.token_urlsafe(48))"
API_ALGORITHM=HS256
API_ACCESS_TOKEN_EXPIRE=120
API_CORS_ORIGINS=["http://localhost:3000"]

STREAMER_BROKER_HOSTS=["localhost:9092"]
STREAMER_SENSORS_TOPIC=tilthwave.sensors.dev
STREAMER_WATER_CONTROL_TOPIC=tilthwave.water-control.dev
LOG_LEVEL=INFO

FLOW_RUNNER_MINUTES=0.2
FLOW_RUNNER_MAX_IRRIGATION_MINUTES=60
FLOW_RUNNER_MAX_READING_AGE_MINUTES=30
