# Tilthwave stack environment. Do not copy by hand: `make env` generates deploy/.env with real secrets.
# Compose reads every variable here; the ones marked (backend) are passed into the backend containers.

# --- Images ---
# local = built from this checkout by `make up`. A release tag (v1.2.3) selects the images the
# release workflow published to ghcr.io; `make deploy` pulls them and starts without building.
TILTHWAVE_TAG=local

# --- Postgres ---
POSTGRES_DB=tilthwave
POSTGRES_USER=postgres
POSTGRES_PASSWORD=                      # generated by `make env`

# --- API (backend) ---
API_SECRET_KEY=                         # generated by `make env`; >= 32 chars, never a placeholder
API_ALGORITHM=HS256
API_ACCESS_TOKEN_EXPIRE=120
API_CORS_ORIGINS=["http://localhost:3000"]
API_TRUSTED_PROXIES=[]                  # reverse proxy IPs whose X-Forwarded-For is believed
FORWARDED_ALLOW_IPS=127.0.0.1           # same, for uvicorn's proxy headers
API_DOCS_ENABLED=true                   # /docs + /openapi.json; the production compose file defaults to false
API_COOKIE_SECURE=false                 # Secure flag on the browser session cookies: true behind TLS in production
API_COOKIE_DOMAIN=                      # blank = host-only (localhost); ".example.com" when web and API sit on different subdomains
API_WEB_BASE_URL=http://localhost:3000  # the web app's public URL: where password-reset links point

# --- Outgoing email (password-reset links) ---
# Leave SMTP_HOST blank locally: nothing is sent, the api container logs the message (with the
# live reset link) instead - `make logs` / `docker logs tilthwave-api`. Fill these in for real mail.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=tilthwave@localhost
SMTP_USE_TLS=true
SMTP_TIMEOUT_SECONDS=10

# --- Seeded admin (dashboard login; used by the seed job only) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=                         # generated by `make env`

# --- Seeded read-only worker the sensor simulator logs in with ---
SIM_USERNAME=simulator
SIM_PASSWORD=                           # generated by `make env`

# --- Broker topics / control loop (backend) ---
SENSORS_TOPIC=tilthwave.sensors.dev
WATER_CONTROL_TOPIC=tilthwave.water-control.dev
LOG_LEVEL=INFO
FLOW_RUNNER_MINUTES=0.2
FLOW_RUNNER_HEARTBEAT_MAX_MINUTES=2     # container healthcheck window; keep it above FLOW_RUNNER_MINUTES
FLOW_RUNNER_MAX_IRRIGATION_MINUTES=60
FLOW_RUNNER_MAX_READING_AGE_MINUTES=30
UVICORN_WORKERS=1                       # the in-process login rate limit is per worker; keep 1 unless limiting at the proxy
STREAMER_WORKERS=1                      # never above the topic partition count (1)

# --- Simulator ---
SENSORS_ROUNDS=0                        # 0 = forever
SENSORS_INTERVAL_SECONDS=15
SENSORS_CYCLE_ROUNDS=10                 # rounds before the values wrap back to their start

# --- Host ports (local only, docker-compose.local.yml; 127.0.0.1 keeps db/broker/console private) ---
BIND_ADDR=127.0.0.1
WEB_PORT=3000
API_PORT=8080
DB_PORT=5432
KAFKA_PORT=9092
CONSOLE_PORT=8082

# --- Web: API URL as seen from the browser (baked into the bundle at build time) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# --- Database backups (db-backup service: pg_dump into the pgbackups volume) ---
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP_DAYS=14

TZ=Europe/Paris
