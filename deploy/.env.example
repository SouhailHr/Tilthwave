# Tilthwave stack environment. Do not copy by hand: `make env` generates deploy/.env with real secrets.
# Compose reads every variable here; the ones marked (backend) are passed into the backend containers.

# --- Postgres ---
POSTGRES_DB=tilthwave
POSTGRES_USER=postgres
POSTGRES_PASSWORD=                      # generated by `make env`

# --- API (backend) ---
API_SECRET_KEY=                         # generated by `make env`; >= 32 chars, never a placeholder
API_ALGORITHM=HS256
API_ACCESS_TOKEN_EXPIRE=120
API_CORS_ORIGINS=["http://localhost:3000"]
API_TRUSTED_PROXIES=[]                  # reverse proxy IPs whose X-Forwarded-For is believed
FORWARDED_ALLOW_IPS=127.0.0.1           # same, for uvicorn's proxy headers
API_DOCS_ENABLED=true                   # /docs + /openapi.json; set false in production

# --- Seeded admin (used by the seed job and the sensor simulator login only) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=                         # generated by `make env`

# --- Broker topics / control loop (backend) ---
SENSORS_TOPIC=tilthwave.sensors.dev
WATER_CONTROL_TOPIC=tilthwave.water-control.dev
LOG_LEVEL=INFO
FLOW_RUNNER_MINUTES=0.2
FLOW_RUNNER_MAX_IRRIGATION_MINUTES=60
FLOW_RUNNER_MAX_READING_AGE_MINUTES=30
UVICORN_WORKERS=1                       # the in-process login rate limit is per worker; keep 1 unless limiting at the proxy
STREAMER_WORKERS=1                      # never above the topic partition count (1)

# --- Simulator ---
SENSORS_ROUNDS=0                        # 0 = forever
SENSORS_INTERVAL_SECONDS=15
SENSORS_CYCLE_ROUNDS=10                 # rounds before the values wrap back to their start

# --- Host binding (127.0.0.1 keeps db/broker/console private to this machine) ---
BIND_ADDR=127.0.0.1
WEB_PORT=3000
API_PORT=8080
DB_PORT=5432
KAFKA_PORT=9092
CONSOLE_PORT=8082

# --- Web: API URL as seen from the browser (baked into the bundle at build time) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

TZ=Europe/Paris
DOMAIN=tilthwave.hannibyte.com
